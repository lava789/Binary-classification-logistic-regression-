      "cell_type": "markdown",
      "source": [
        "**Step 10 — Combine retrieval + generation into an actual RAG answer**"
      ],
      "metadata": {
        "id": "TBSrSZs4Q1Pp"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def rag_query(question, k=2):\n",
        "    \"\"\"Retrieve relevant chunks, then generate an answer using them as context\"\"\"\n",
        "\n",
        "    # 1. Retrieve relevant chunks\n",
        "    results = vectorstore.similarity_search(question, k=k)\n",
        "    context = \"\\n\\n\".join([doc.page_content for doc in results])\n",
        "\n",
        "    # 2. Build a prompt that grounds the LLM in the retrieved context\n",
        "    prompt = f\"\"\"Answer the question based only on the context below.\n",
        "If the answer isn't in the context, say you don't know.\n",
        "\n",
        "Context:\n",
        "{context}\n",
        "\n",
        "Question: {question}\n",
        "\n",
        "Answer:\"\"\"\n",
        "\n",
        "    # 3. Generate the answer\n",
        "    response = llm.invoke(prompt)\n",
        "\n",
        "    print(f\"Question: {question}\\n\")\n",
        "    print(f\"Retrieved context:\\n{context}\\n\")\n",
        "    print(f\"Answer: {response.content}\")\n",
        "\n",
        "    return response.content\n",
        "\n",
        "rag_query(\"What does Tesla do?\")"
      ],
